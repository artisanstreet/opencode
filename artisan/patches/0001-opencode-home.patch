From 95b7c532f8f7c46e5efa25d4f0af6fc68fb53e93 Mon Sep 17 00:00:00 2001
From: ss <69873514+sandersonstabo@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:53:55 +0200
Subject: [PATCH] feat(util): OPENCODE_HOME roots every global path

OPENCODE_HOME replaces the four XDG base directories for opencode alone:
data, config, cache and state resolve under $OPENCODE_HOME/<kind>/opencode.
A host that isolates opencode no longer has to override XDG_*_HOME for the
whole process tree, so the shells and tools opencode runs keep the user's
own gh, git and toolchain configuration. Unset, nothing changes.

The service registration fallback in the client follows the same root.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/cli/test/debug-paths.test.ts | 30 +++++++++++++++++++++++++++
 packages/client/src/service-probe.ts  |  4 +++-
 packages/util/src/global-roots.ts     | 19 +++++++++++++----
 packages/web/src/content/docs/cli.mdx |  1 +
 4 files changed, 49 insertions(+), 5 deletions(-)

diff --git a/packages/cli/test/debug-paths.test.ts b/packages/cli/test/debug-paths.test.ts
index 60e00ec4db..8940acfc14 100644
--- a/packages/cli/test/debug-paths.test.ts
+++ b/packages/cli/test/debug-paths.test.ts
@@ -48,6 +48,36 @@ describe("debug paths command", () => {
       await fs.rm(root, { recursive: true, force: true })
     }
   })
+
+  test("roots every global path under OPENCODE_HOME over the XDG directories", async () => {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), "opencode-debug-paths-"))
+
+    try {
+      const result = await cli(["debug", "paths"], {
+        OPENCODE_HOME: path.join(root, "own"),
+        XDG_DATA_HOME: path.join(root, "data"),
+        XDG_CONFIG_HOME: path.join(root, "config"),
+        XDG_CACHE_HOME: path.join(root, "cache"),
+        XDG_STATE_HOME: path.join(root, "state"),
+      })
+      const paths = Object.fromEntries(
+        result.stdout
+          .trim()
+          .split("\n")
+          .map((line) => line.trim().split(/\s+/, 2)),
+      )
+
+      expect({ exitCode: result.exitCode, stderr: result.stderr }).toEqual({ exitCode: 0, stderr: "" })
+      expect(paths).toMatchObject({
+        data: path.join(root, "own", "data", "opencode"),
+        config: path.join(root, "own", "config", "opencode"),
+        cache: path.join(root, "own", "cache", "opencode"),
+        state: path.join(root, "own", "state", "opencode"),
+      })
+    } finally {
+      await fs.rm(root, { recursive: true, force: true })
+    }
+  })
 })
 
 async function cli(args: string[], env?: Record<string, string>) {
diff --git a/packages/client/src/service-probe.ts b/packages/client/src/service-probe.ts
index 7f61c84f8e..6af100b444 100644
--- a/packages/client/src/service-probe.ts
+++ b/packages/client/src/service-probe.ts
@@ -37,7 +37,9 @@ function fail(message: string) {
 
 /** The default registration file. */
 export function fallback() {
-  return join(process.env["XDG_STATE_HOME"] ?? join(homedir(), ".local", "state"), "opencode", "service.json")
+  const own = process.env["OPENCODE_HOME"]
+  const state = own ? join(own, "state") : (process.env["XDG_STATE_HOME"] ?? join(homedir(), ".local", "state"))
+  return join(state, "opencode", "service.json")
 }
 
 /** Whether two registrations describe the same service instance. */
diff --git a/packages/util/src/global-roots.ts b/packages/util/src/global-roots.ts
index a9324e4987..9bac1d977a 100644
--- a/packages/util/src/global-roots.ts
+++ b/packages/util/src/global-roots.ts
@@ -2,10 +2,21 @@ import os from "os"
 import path from "path"
 
 const home = os.homedir()
-const data = process.env.XDG_DATA_HOME || (home ? path.join(home, ".local", "share") : undefined)
-const cache = process.env.XDG_CACHE_HOME || (home ? path.join(home, ".cache") : undefined)
-const config = process.env.XDG_CONFIG_HOME || (home ? path.join(home, ".config") : undefined)
-const state = process.env.XDG_STATE_HOME || (home ? path.join(home, ".local", "state") : undefined)
+// OPENCODE_HOME replaces every XDG base directory for opencode alone, so an
+// isolated instance does not pass XDG overrides on to the tools it runs.
+const own = process.env.OPENCODE_HOME
+const data = own
+  ? path.join(own, "data")
+  : process.env.XDG_DATA_HOME || (home ? path.join(home, ".local", "share") : undefined)
+const cache = own
+  ? path.join(own, "cache")
+  : process.env.XDG_CACHE_HOME || (home ? path.join(home, ".cache") : undefined)
+const config = own
+  ? path.join(own, "config")
+  : process.env.XDG_CONFIG_HOME || (home ? path.join(home, ".config") : undefined)
+const state = own
+  ? path.join(own, "state")
+  : process.env.XDG_STATE_HOME || (home ? path.join(home, ".local", "state") : undefined)
 
 /** The XDG base directories that root opencode's global paths. */
 export function roots(app: string) {
diff --git a/packages/web/src/content/docs/cli.mdx b/packages/web/src/content/docs/cli.mdx
index 8d1bdaf39f..d0210817b2 100644
--- a/packages/web/src/content/docs/cli.mdx
+++ b/packages/web/src/content/docs/cli.mdx
@@ -679,6 +679,7 @@ OpenCode can be configured using environment variables.
 | `OPENCODE_CONFIG`                     | string  | Path to config file                               |
 | `OPENCODE_TUI_CONFIG`                 | string  | Path to TUI config file                           |
 | `OPENCODE_CONFIG_DIR`                 | string  | Path to config directory                          |
+| `OPENCODE_HOME`                       | string  | Root for data, config, cache and state; replaces the XDG directories for opencode only |
 | `OPENCODE_CONFIG_CONTENT`             | string  | Inline json config content                        |
 | `OPENCODE_DISABLE_AUTOUPDATE`         | boolean | Disable automatic update checks                   |
 | `OPENCODE_DISABLE_PRUNE`              | boolean | Disable pruning of old data                       |
